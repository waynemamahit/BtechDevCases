                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.transferId).to.eql(pm.collectionVariables.get('transferId'));",
                  "    pm.expect(body.recipient).to.eql(pm.collectionVariables.get('recipientEmail'));",
                  "    pm.expect(body.amount).to.eql(2500);",
                  "    pm.expect(body.notes).to.eql('lunch');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{senderToken}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transferId\": \"{{transferId}}\",\n  \"recipient\": \"{{recipientEmail}}\",\n  \"amount\": 2500,\n  \"notes\": \"lunch\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/transfers",
            "description": "2500 minor units is 25.00. The caller chooses transferId."
          }
        },
        {
          "name": "GET /wallet sender after transfer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('sender balance is 97500 with one sent row', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.balance).to.eql(97500);",
                  "    pm.expect(body.transfers).to.have.lengthOf(1);",
                  "    pm.expect(body.transfers[0].direction).to.eql('sent');",
                  "    pm.expect(body.transfers[0].counterparty).to.eql(pm.collectionVariables.get('recipientEmail'));",
                  "    pm.expect(body.transfers[0].amount).to.eql(2500);",
                  "    pm.expect(body.transfers[0].notes).to.eql('lunch');",
                  "    pm.expect(body.transfers[0].transferId).to.eql(pm.collectionVariables.get('transferId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{senderToken}}", "type": "string" }
              ]
