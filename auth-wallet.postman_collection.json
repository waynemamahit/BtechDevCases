                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.balance).to.eql(100000);",
                  "    pm.expect(body.transfers).to.eql([]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{recipientToken}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/wallet"
          }
        },
        {
          "name": "POST /transfers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
