              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/register",
            "description": "Uses the sender created in 01 Happy path. The MySQL unique key rejects the duplicate."
          }
        },
        {
          "name": "Different email case is a new account",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = pm.collectionVariables.get('senderEmail') || '';",
                  "const at = email.indexOf('@');",
                  "const local = at === -1 ? email : email.slice(0, at);",
                  "const domain = at === -1 ? 'example.com' : email.slice(at + 1);",
                  "const cased = (local.charAt(0).toUpperCase() + local.slice(1)) + '@' + domain;",
                  "pm.collectionVariables.set('casedEmail', cased);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('201 for a different case', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(body.email).to.eql(pm.collectionVariables.get('casedEmail'));",
                  "    pm.expect(body.email).to.not.eql(pm.collectionVariables.get('senderEmail'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{casedEmail}}\",\n  \"password\": \"{{senderPassword}}\",\n  \"confirmPassword\": \"{{senderPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/register",
            "description": "Ada...@example.com is stored separately from ada...@example.com."
          }
        }
      ]
    },
    {
      "name": "03 Login errors",
      "item": [
        {
          "name": "Wrong password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 invalid credentials', function () {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().error).to.eql('invalid credentials');",
                  "    pm.expect(pm.response.json()).to.not.have.property('token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
