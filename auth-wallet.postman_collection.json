                  "    pm.expect(body.balance).to.eql(102500);",
                  "    pm.expect(body.transfers).to.have.lengthOf(1);",
                  "    pm.expect(body.transfers[0].direction).to.eql('received');",
                  "    pm.expect(body.transfers[0].counterparty).to.eql(pm.collectionVariables.get('senderEmail'));",
