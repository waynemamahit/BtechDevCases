              "bearer": [
                { "key": "token", "value": "{{senderToken}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/wallet"
          }
        }
      ]
    },
    {
      "name": "02 Registration errors",
      "description": "Field checks return 400 with { \"error\" }. A second registration of the sender email returns 409. A different letter case is a different account.",
      "item": [
        {
          "name": "Missing email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 email is required', function () {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().error).to.eql('email is required');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
