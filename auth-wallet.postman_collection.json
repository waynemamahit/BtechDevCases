                  "    pm.expect(body.balance).to.eql(100000);",
                  "    pm.expect(body.transfers).to.eql([]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{senderToken}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/wallet"
          }
        },
        {
          "name": "GET /wallet recipient opening",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
