{
  "info": {
    "name": "Auth Wallet API",
    "description": "Manual checks for the Go auth and wallet API.\n\nStart the stack with `docker compose up --build`. The API listens on http://localhost:8080.\n\nRun this collection in order with the Postman Collection Runner. The first request mints a new sender email, recipient email, and transfer id, so a second run does not collide with accounts already stored in MySQL.\n\nAmounts are integer minor units. 100 minor units equal 1.00. A new wallet starts at 100000 (1000.00).\n\nEmail match is exact, including case. The bearer token is an HS256 JWT. A successful login or a later successful authenticated request keeps the session alive. After 15 minutes without one, protected routes return 401.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "senderEmail", "value": "" },
    { "key": "senderPassword", "value": "s3cret" },
    { "key": "recipientEmail", "value": "" },
    { "key": "recipientPassword", "value": "s3cret" },
    { "key": "senderId", "value": "" },
    { "key": "recipientId", "value": "" },
    { "key": "senderToken", "value": "" },
    { "key": "recipientToken", "value": "" },
    { "key": "transferId", "value": "" },
    { "key": "runId", "value": "" }
  ],
  "item": [
    {
      "name": "01 Happy path",
      "description": "Registers two accounts, logs in, reads the welcome sentence and opening balances, sends 2500 minor units, then repeats the same transfer id.",
      "item": [
        {
          "name": "Register sender",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = Date.now().toString(36);",
                  "pm.collectionVariables.set('runId', runId);",
                  "pm.collectionVariables.set('senderEmail', 'ada.' + runId + '@example.com');",
                  "pm.collectionVariables.set('recipientEmail', 'bob.' + runId + '@example.com');",
                  "pm.collectionVariables.set('senderPassword', 's3cret');",
                  "pm.collectionVariables.set('recipientPassword', 's3cret');",
                  "pm.collectionVariables.set('transferId', 't-' + runId);",
                  "pm.collectionVariables.set('senderToken', '');",
                  "pm.collectionVariables.set('recipientToken', '');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('201 with id and email and no password', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(body.id).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.email).to.eql(pm.collectionVariables.get('senderEmail'));",
                  "    pm.expect(body).to.not.have.property('password');",
                  "});",
                  "pm.collectionVariables.set('senderId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{senderEmail}}\",\n  \"password\": \"{{senderPassword}}\",\n  \"confirmPassword\": \"{{senderPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/register",
            "description": "Creates the sender and a wallet of 100000 minor units."
          }
        },
        {
          "name": "Register recipient",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('201 with id and email and no password', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(body.id).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.email).to.eql(pm.collectionVariables.get('recipientEmail'));",
                  "    pm.expect(body).to.not.have.property('password');",
                  "});",
                  "pm.collectionVariables.set('recipientId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{recipientEmail}}\",\n  \"password\": \"{{recipientPassword}}\",\n  \"confirmPassword\": \"{{recipientPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/register"
          }
        },
        {
          "name": "Login sender",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 with a token', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('senderToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{senderEmail}}\",\n  \"password\": \"{{senderPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/login",
            "description": "Saves the HS256 JWT on the collection variable senderToken. Claims are sub (user id) and email. The token expires 24 hours after issue."
          }
        },
        {
          "name": "Login recipient",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 with a token', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('recipientToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{recipientEmail}}\",\n  \"password\": \"{{recipientPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/login"
          }
        },
        {
          "name": "GET /me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('exact welcome sentence', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('text/plain');",
                  "    pm.expect(pm.response.text()).to.eql('Hello ' + pm.collectionVariables.get('senderEmail') + ', welcome back');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{senderToken}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/me",
            "description": "Body is exactly `Hello <email>, welcome back` with no extra characters."
          }
        },
        {
          "name": "GET /wallet sender opening",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('opening balance is 100000 and history is empty', function () {",
