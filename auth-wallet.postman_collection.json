            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transferId\": \"{{transferId}}\",\n  \"recipient\": \"{{recipientEmail}}\",\n  \"amount\": 2500,\n  \"notes\": \"lunch\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/transfers",
            "description": "Repeating the sender's transfer id with the same recipient, amount, and notes does not move money again."
          }
        },
